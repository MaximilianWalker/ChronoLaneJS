{
  "name": "chronolane",
  "version": "0.1.0",
  "description": "A composable, timezone-aware calendar toolkit for React.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaximilianWalker/chronolane.git"
  },
  "bugs": {
    "url": "https://github.com/MaximilianWalker/chronolane/issues"
  },
  "homepage": "https://github.com/MaximilianWalker/chronolane#readme",
  "keywords": [
    "calendar",
    "date-fns",
    "react",
    "resource-calendar",
    "scheduler",
    "time-grid",
    "timezone"
  ],
  "files": [
    "dist",
    "index.d.ts",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/chronolane.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "check": "npm run locales:check && npm run test && npm run test:timezones && npm run types:check && npm run lint && npm run build && npm run package:verify",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "locales:check": "node scripts/generate-calendar-locales.mjs --check",
    "locales:generate": "node scripts/generate-calendar-locales.mjs",
    "package:verify": "node scripts/verify-package.mjs",
    "prepack": "npm run check",
    "test": "node --no-warnings --test \"test/**/*.test.js\"",
    "test:timezones": "node scripts/verify-timezones.mjs",
    "types:check": "tsc --noEmit --strict --skipLibCheck false --moduleResolution bundler --module preserve --target ES2022 --jsx react-jsx index.d.ts"
  },
  "peerDependencies": {
    "@date-fns/tz": ">=1.5.0 <2",
    "date-fns": ">=4.1.0 <5",
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@date-fns/tz": "^1.5.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "date-fns": "^4.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}

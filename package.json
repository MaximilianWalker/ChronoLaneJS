{
  "name": "@chronolanejs/react",
  "version": "0.1.0-rc.0",
  "description": "An open-source React and TypeScript calendar and scheduler with accessible views, resources, event interactions, and timezone support.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaximilianWalker/ChronoLaneJS.git"
  },
  "bugs": {
    "url": "https://github.com/MaximilianWalker/ChronoLaneJS/issues"
  },
  "homepage": "https://maximilianwalker.github.io/ChronoLaneJS/",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "calendar",
    "date-fns",
    "event-calendar",
    "react",
    "react-calendar",
    "resource-calendar",
    "scheduler",
    "time-grid",
    "timezone",
    "typescript"
  ],
  "files": [
    "assets/chronolane-logo.png",
    "assets/chronolane-logo.svg",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/chronolanejs.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "api:check": "npm run types:build && api-extractor run",
    "api:report": "npm run types:build && api-extractor run --local",
    "build": "vite build && npm run types:build",
    "check": "npm run locales:check && npm run docs:check && npm run release:verify && npm run test && npm run test:timezones && npm run types:check && npm run types:test && npm run lint && npm run build && npm run api:check && npm run package:verify",
    "dev": "vite build --watch",
    "docs:check": "tsx scripts/verifyDocumentation.ts",
    "consumers:verify": "tsx scripts/verifyConsumers.ts",
    "examples:check": "npm run build && npm run examples:install && npm run examples:lint && npm run consumers:verify",
    "examples:install": "npm ci --prefix examples/vite --ignore-scripts --no-audit --no-fund && npm ci --prefix examples/next --ignore-scripts --no-audit --no-fund",
    "examples:lint": "eslint examples",
    "lint": "eslint . --ignore-pattern \"examples/**\"",
    "locales:check": "tsx scripts/generateLocaleLoaders.ts --check",
    "locales:generate": "tsx scripts/generateLocaleLoaders.ts",
    "package:verify": "tsx scripts/verifyPackage.ts",
    "prepack": "npm run check",
    "release:verify": "node scripts/verifyRelease.mjs",
    "test": "node --import tsx --no-warnings --test \"test/**/*.test.ts\"",
    "test:timezones": "tsx scripts/verifyTimezones.ts",
    "types:build": "tsc -p tsconfig.build.json",
    "types:check": "tsc -p tsconfig.json",
    "types:test": "tsc -p tsconfig.types-test.json",
    "types:check:storybook": "tsc -p tsconfig.storybook.json",
    "storybook": "storybook dev --port 6006",
    "storybook:build": "storybook build --output-dir storybook-static",
    "storybook:test": "vitest --project=storybook --run",
    "storybook:test:watch": "vitest --project=storybook",
    "check:storybook": "npm run types:check:storybook && npm run storybook:test && npm run storybook:build",
    "site": "vite --config vite.site.config.ts",
    "site:build": "tsc -p tsconfig.site.json && vite build --config vite.site.config.ts && tsx --tsconfig tsconfig.site.json scripts/generateSite.ts && npm run site:verify",
    "site:bundle": "npm run site:build && storybook build --output-dir site-dist/storybook",
    "site:verify": "tsx --tsconfig tsconfig.site.json scripts/verifySite.ts",
    "site:preview": "vite preview --config vite.site.config.ts"
  },
  "peerDependencies": {
    "@date-fns/tz": ">=1.5.0 <2",
    "date-fns": ">=4.1.0 <5",
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@date-fns/tz": "^1.5.0",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.12",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "conventional-changelog-conventionalcommits": "^10.3.0",
    "date-fns": "^4.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-storybook": "^10.5.7",
    "github-slugger": "^2.0.0",
    "globals": "^17.9.0",
    "playwright": "^1.62.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "semantic-release": "^25.0.9",
    "storybook": "^10.5.7",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "unified": "^11.0.5",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^22.14.0 || ^24.10.0 || ^26.0.0"
  }
}
